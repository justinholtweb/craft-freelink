{# FreeLink 6 port test template (removed after testing). #}
{%- set cta = entry.fl6Cta -%}
URL={{ cta.url }}|TEXT={{ cta.text }}|LINK={{ cta.link }}|ICON={{ cta.iconSvg ? 'svg' : 'none' }}|TARGET={{ cta.target }}
{%- for l in entry.fl6Links.all %}|M{{ loop.index }}={{ l.type }}:{{ l.url }}{% endfor %}
