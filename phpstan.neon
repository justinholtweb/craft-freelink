includes:
    - vendor/craftcms/phpstan/phpstan.neon

parameters:
    level: 6
    paths:
        - src
    ignoreErrors:
        # Elements::getElementById() is generic on the element type; when called
        # without an explicit type (reverse lookups where the type is unknown)
        # PHPStan cannot resolve the template type. Return is ElementInterface|null.
        -
            message: '#Unable to resolve the template type T in call to method craft\\services\\Elements::getElementById\(\)#'
            path: src/twig/Extension.php
