{% import '_includes/forms' as forms %}

<h2>{{ 'Sidebar'|t('freelink') }}</h2>

{{ forms.textField({
    label: 'Sidebar label'|t('freelink'),
    instructions: 'The name of the FreeLink item in the control panel sidebar. Leave blank to use “FreeLink”.'|t('freelink'),
    id: 'navLabel',
    name: 'navLabel',
    value: settings.navLabel,
    placeholder: 'FreeLink',
    maxlength: 64,
    errors: settings.getErrors('navLabel'),
}) }}

{{ forms.iconPickerField({
    label: 'Sidebar icon'|t('freelink'),
    instructions: 'An icon from Craft’s icon set.'|t('freelink'),
    id: 'navIcon',
    name: 'navIcon',
    value: settings.navIcon,
    errors: settings.getErrors('navIcon'),
}) }}

{{ forms.textareaField({
    label: 'Custom sidebar icon (SVG)'|t('freelink'),
    instructions: 'Paste a single `<svg>` element to use instead of the icon above. It is sanitised before it is shown: scripts, event handlers and external references are removed.'|t('freelink'),
    id: 'navIconSvg',
    name: 'navIconSvg',
    value: settings.navIconSvg,
    class: 'code',
    rows: 4,
    errors: settings.getErrors('navIconSvg'),
}) }}

<p class="light smalltext">{{ 'A control panel navigation plugin, or Craft’s own navigation editor where it has one, overrides these.'|t('freelink') }}</p>

<hr>

<h2>{{ 'Reverse lookups'|t('freelink') }}</h2>

{{ forms.lightswitchField({
    label: 'Show “Linked from” on edit screens'|t('freelink'),
    instructions: 'Lists FreeLink links that point at the element being edited, for users who can view the Links screen.'|t('freelink'),
    id: 'showReverseLookupPanel',
    name: 'showReverseLookupPanel',
    on: settings.showReverseLookupPanel,
}) }}

<hr>

<h2>{{ 'Link checks'|t('freelink') }}</h2>

{{ forms.lightswitchField({
    label: 'Check URL links over HTTP'|t('freelink'),
    instructions: 'When off, FreeLink never requests a URL. Element links are still checked against the database.'|t('freelink'),
    id: 'enableExternalChecks',
    name: 'enableExternalChecks',
    on: settings.enableExternalChecks,
}) }}

{{ forms.textField({
    label: 'Recheck after (hours)'|t('freelink'),
    id: 'recheckAfter',
    name: 'recheckAfter',
    type: 'number',
    min: 1,
    size: 6,
    value: settings.recheckAfter,
    errors: settings.getErrors('recheckAfter'),
}) }}

{{ forms.textField({
    label: 'Delay between requests to one host (ms)'|t('freelink'),
    id: 'hostDelay',
    name: 'hostDelay',
    type: 'number',
    min: 0,
    size: 6,
    value: settings.hostDelay,
    errors: settings.getErrors('hostDelay'),
}) }}

{{ forms.textField({
    label: 'URLs per check run'|t('freelink'),
    id: 'maxChecksPerRun',
    name: 'maxChecksPerRun',
    type: 'number',
    min: 1,
    size: 6,
    value: settings.maxChecksPerRun,
    errors: settings.getErrors('maxChecksPerRun'),
}) }}

<p class="light smalltext">{{ 'Checks only request http and https URLs saved in FreeLink fields, refuse private, loopback and metadata addresses (also after redirects), and send the user agent “FreeLinkChecker/5.3”. Hosts and ports that may be reached otherwise can only be set in config/freelink.php (`checkAllowedHosts`, `checkAllowedPorts`).'|t('freelink') }}</p>
