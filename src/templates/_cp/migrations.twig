{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set selectedSubnavItem = 'migrations' %}
{% set title = 'Migrations'|t('freelink') %}

{% set labels = {
    hyper: 'Hyper (Verbb)',
    linkit: 'Linkit',
    typedlinkfield: 'Typed Link Field',
    craftlink: 'Craft Link field',
} %}

{% block content %}
    <p class="readable">{{ 'Convert link fields from another plugin into FreeLink fields, with their content. Run a dry run first: it reports what would change and writes nothing.'|t('freelink') }}</p>

    {% if lastRun %}
        <h2>{{ lastRun.dryRun ? 'Last dry run'|t('freelink') : 'Last migration'|t('freelink') }}: {{ labels[lastRun.source] ?? lastRun.source }}{% if lastRun.field %} — <code>{{ lastRun.field }}</code>{% endif %}</h2>
        <pre class="freelink-migration-log" style="max-height: 320px; overflow:auto; background: var(--gray-050); padding: var(--m); border-radius: var(--small-border-radius);">{{ lastRun.log|join("\n") }}</pre>
        <hr>
    {% endif %}

    <h2>{{ 'Available migrations'|t('freelink') }}</h2>

    {% if available|length %}
        {% if not allowAdminChanges %}
            <blockquote class="note warning"><p>{{ 'Migrations change field types, so they can only run where admin changes are allowed.'|t('freelink') }}</p></blockquote>
        {% endif %}

        {% for key, info in available %}
            <div class="freelink-migration" style="margin-bottom: var(--xl);">
                <h3>{{ labels[key] ?? info.label }} <span class="light">— {{ '{count, plural, =1{# field} other{# fields}} found'|t('freelink', {count: info.fieldCount}) }}</span></h3>

                {% if allowAdminChanges %}
                    <form method="post" accept-charset="UTF-8">
                        {{ csrfInput() }}
                        {{ actionInput('freelink/migrations/run') }}
                        {{ hiddenInput('source', key) }}

                        {{ forms.textField({
                            label: 'Field handle'|t('freelink'),
                            instructions: 'Leave blank to migrate every field of this type.'|t('freelink'),
                            id: 'freelink-migrate-field-' ~ key,
                            name: 'field',
                            size: 30,
                        }) }}

                        {{ forms.lightswitchField({
                            label: 'Dry run'|t('freelink'),
                            instructions: 'Report what would change without writing anything.'|t('freelink'),
                            id: 'freelink-migrate-dryrun-' ~ key,
                            name: 'dryRun',
                            on: true,
                        }) }}

                        {{ forms.lightswitchField({
                            label: 'Back up the database first'|t('freelink'),
                            id: 'freelink-migrate-backup-' ~ key,
                            name: 'backup',
                            on: true,
                        }) }}

                        <button type="submit" class="btn submit">{{ 'Run'|t('freelink') }}</button>
                    </form>
                {% endif %}

                <p class="light smalltext">{{ 'Console:'|t('freelink') }} <code>php craft freelink/migrate/from-{{ key == 'typedlinkfield' ? 'typed-link' : (key == 'craftlink' ? 'craft-link' : key) }} --dry-run</code></p>
            </div>
        {% endfor %}
    {% else %}
        <p class="light">{{ 'No compatible link field plugins detected.'|t('freelink') }}</p>
    {% endif %}

    <hr>

    <h2>{{ 'Migration history'|t('freelink') }}</h2>

    {% if history|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ 'Source'|t('freelink') }}</th>
                    <th scope="col">{{ 'Field'|t('app') }}</th>
                    <th scope="col">{{ 'Status'|t('app') }}</th>
                    <th scope="col">{{ 'Date'|t('app') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for migration in history %}
                    <tr>
                        <td>{{ labels[migration.sourcePlugin] ?? migration.sourcePlugin }}</td>
                        <td>{{ fieldNames[migration.fieldId] ?? ('Field #{id}'|t('freelink', {id: migration.fieldId})) }}</td>
                        <td>
                            <span class="status {{ migration.status == 'complete' ? 'green' : (migration.status == 'failed' ? 'red' : 'orange') }}"></span>
                            {{ migration.status }}
                        </td>
                        <td>{{ migration.dateUpdated|datetime('short') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="light">{{ 'No migrations have been run yet.'|t('freelink') }}</p>
    {% endif %}
{% endblock %}
