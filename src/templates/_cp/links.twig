{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set selectedSubnavItem = subnav %}
{% set title = subnav == 'broken' ? 'Broken Links'|t('freelink') : 'Links'|t('freelink') %}

{% set statusLabels = {
    live: 'Live'|t('freelink'),
    missing: 'Target deleted'|t('freelink'),
    trashed: 'Target in trash'|t('freelink'),
    disabled: 'Target disabled'|t('freelink'),
    pending: 'Target not yet published'|t('freelink'),
    expired: 'Target expired'|t('freelink'),
    ok: 'OK'|t('freelink'),
    redirect: 'Redirects'|t('freelink'),
    broken: 'Broken'|t('freelink'),
    error: 'Error'|t('freelink'),
    blocked: 'Refused'|t('freelink'),
    unchecked: 'Not checked yet'|t('freelink'),
    'n/a': 'Not checked'|t('freelink'),
} %}
{% set statusColours = {
    live: 'green', ok: 'green', redirect: 'orange',
    missing: 'red', trashed: 'red', broken: 'red', blocked: 'red',
    disabled: 'orange', pending: 'orange', expired: 'orange', error: 'orange',
    unchecked: 'disabled', 'n/a': 'disabled',
} %}

{% block actionButton %}
    <div class="flex">
        {% if isAdmin %}
            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('freelink/links/reindex') }}
                {{ redirectInput(craft.app.request.url) }}
                <button type="submit" class="btn">{{ 'Rebuild index'|t('freelink') }}</button>
            </form>
        {% endif %}
        {% if canCheck and settings.enableExternalChecks %}
            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('freelink/links/queue-check') }}
                {{ redirectInput(craft.app.request.url) }}
                <button type="submit" class="btn submit">{{ 'Check links now'|t('freelink') }}</button>
            </form>
        {% endif %}
    </div>
{% endblock %}

{% block content %}
    {% if not indexBuilt %}
        <div class="readable" style="margin-bottom: var(--l);">
            <blockquote class="note">
                <p>{{ 'The link index is being built. Links saved before FreeLink 5.3 appear here once the “Indexing FreeLink links” queue job has run.'|t('freelink') }}</p>
            </blockquote>
        </div>
    {% endif %}

    {% if targetElement or filters.target %}
        <div class="flex" style="margin-bottom: var(--m);">
            <span>{{ 'Links to'|t('freelink') }}</span>
            {% if targetElement %}
                {{ elementChip(targetElement) }}
            {% else %}
                <span class="light">{{ 'Element #{id}'|t('freelink', {id: filters.target}) }}</span>
            {% endif %}
            <a href="{{ cpUrl(path, baseParams|filter((v, k) => k != 'target')) }}" class="btn small">{{ 'Show all links'|t('freelink') }}</a>
        </div>
    {% endif %}

    <form method="get" action="{{ cpUrl(path) }}" class="freelink-filters" style="display:flex; flex-wrap:wrap; gap: var(--s) var(--m); align-items:flex-end; margin-bottom: var(--l);">
        {% if filters.target %}{{ hiddenInput('target', filters.target) }}{% endif %}

        {{ forms.selectField({
            label: 'Status'|t('freelink'),
            id: 'freelink-filter-status',
            name: 'status',
            value: filters.status,
            options: [
                {label: 'All'|t('freelink'), value: 'all'},
                {label: 'Problems'|t('freelink'), value: 'problems'},
                {label: 'OK'|t('freelink'), value: 'ok'},
                {label: 'Not checked yet'|t('freelink'), value: 'unchecked'},
            ],
        }) }}

        {{ forms.selectField({
            label: 'Link Type'|t('freelink'),
            id: 'freelink-filter-type',
            name: 'type',
            value: filters.type,
            options: [{label: 'All'|t('freelink'), value: ''}]|merge(typeOptions),
        }) }}

        {{ forms.selectField({
            label: 'Field'|t('app'),
            id: 'freelink-filter-field',
            name: 'field',
            value: filters.field,
            options: [{label: 'All'|t('freelink'), value: ''}]|merge(fieldOptions),
        }) }}

        {% if siteOptions|length %}
            {{ forms.selectField({
                label: 'Site'|t('app'),
                id: 'freelink-filter-site',
                name: 'site',
                value: filters.site,
                options: [{label: 'All'|t('freelink'), value: ''}]|merge(siteOptions),
            }) }}
        {% endif %}

        {{ forms.selectField({
            label: 'Source'|t('freelink'),
            id: 'freelink-filter-source',
            name: 'source',
            value: filters.source,
            options: [{label: 'All'|t('freelink'), value: ''}]|merge(sourceOptions),
        }) }}

        {% if sectionOptions|length %}
            {{ forms.selectField({
                label: 'Section'|t('app'),
                id: 'freelink-filter-section',
                name: 'section',
                value: filters.section,
                options: [{label: 'All'|t('freelink'), value: ''}]|merge(sectionOptions),
            }) }}
        {% endif %}

        {{ forms.textField({
            label: 'Domain'|t('freelink'),
            id: 'freelink-filter-domain',
            name: 'domain',
            value: filters.domain,
            placeholder: 'example.com',
            size: 18,
        }) }}

        <div class="field">
            <button type="submit" class="btn">{{ 'Filter'|t('freelink') }}</button>
            <a class="btn" href="{{ cpUrl(path) }}">{{ 'Reset'|t('freelink') }}</a>
        </div>
    </form>

    {% if rows|length %}
        <div class="tableview tablepane">
            <table class="data fullwidth freelink-links-table">
                <thead>
                    <tr>
                        <th scope="col">{{ 'Source'|t('freelink') }}</th>
                        <th scope="col">{{ 'Field'|t('app') }}</th>
                        <th scope="col">{{ 'Type'|t('app') }}</th>
                        <th scope="col">{{ 'Target'|t('freelink') }}</th>
                        <th scope="col">{{ 'Status'|t('app') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        {% set ref = row.ref %}
                        {% set status = ref.getStatus() %}
                        <tr data-id="{{ ref.id }}">
                            <th scope="row">
                                {% if row.root %}
                                    {{ elementChip(row.root) }}
                                    {% if row.nested %}<div class="smalltext light">{{ 'In a nested element'|t('freelink') }}</div>{% endif %}
                                {% else %}
                                    <span class="light">{{ 'A source you can’t view'|t('freelink') }}</span>
                                {% endif %}
                            </th>
                            <td>{{ row.field ? row.field.name : '' }}{% if row.field %}<div class="smalltext light"><code>{{ row.field.handle }}</code></div>{% endif %}</td>
                            <td><code>{{ ref.type }}</code></td>
                            <td>
                                {% if ref.isElement %}
                                    {% if row.target %}
                                        {{ elementChip(row.target) }}
                                    {% elseif ref.targetId %}
                                        <span class="light">{{ 'Element #{id}'|t('freelink', {id: ref.targetId}) }}</span>
                                    {% else %}
                                        <span class="light">{{ 'Deleted element'|t('freelink') }}</span>
                                    {% endif %}
                                {% elseif ref.url %}
                                    {% if ref.host %}
                                        <a href="{{ ref.url }}" target="_blank" rel="noopener noreferrer" class="go" title="{{ ref.url }}">{{ ref.url|length > 70 ? ref.url|slice(0, 70) ~ '…' : ref.url }}</a>
                                    {% else %}
                                        <code>{{ ref.url|length > 70 ? ref.url|slice(0, 70) ~ '…' : ref.url }}</code>
                                    {% endif %}
                                {% else %}
                                    <span class="light">{{ 'No URL'|t('freelink') }}</span>
                                {% endif %}
                                {% if ref.label %}<div class="smalltext light">{{ ref.label }}</div>{% endif %}
                            </td>
                            <td>
                                <span class="status {{ statusColours[status] ?? 'disabled' }}" role="img" aria-label="{{ statusLabels[status] ?? status }}"></span>
                                {{ statusLabels[status] ?? status }}
                                {% if ref.httpCode %}<span class="light">({{ ref.httpCode }})</span>{% endif %}
                                {% if ref.checkError %}<div class="smalltext light">{{ ref.checkError }}</div>{% endif %}
                                {% if ref.finalUrl %}<div class="smalltext light" title="{{ ref.finalUrl }}">→ {{ ref.finalUrl|length > 50 ? ref.finalUrl|slice(0, 50) ~ '…' : ref.finalUrl }}</div>{% endif %}
                                {% if ref.checkedAt %}<div class="smalltext light">{{ ref.checkedAt|timestamp('short') }}</div>{% endif %}
                                {% if ref.isElement and ref.targetId %}
                                    <div class="smalltext"><a href="{{ cpUrl('freelink/links', {target: ref.targetId}) }}">{{ 'All links to this'|t('freelink') }}</a></div>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="zilch">{{ 'No links match these filters.'|t('freelink') }}</p>
    {% endif %}

    <div style="margin-top: var(--m);">
        {% include '_includes/pagination' with {
            pageInfo: pageInfo,
            itemLabel: 'link'|t('freelink'),
            itemsLabel: 'links'|t('freelink'),
        } %}
    </div>

    <p class="light smalltext" style="margin-top: var(--m);">
        {% if not settings.enableExternalChecks %}
            {{ 'External link checks are turned off. Element links are still checked against the database.'|t('freelink') }}
        {% elseif lastChecked %}
            {{ 'URLs last checked {date}.'|t('freelink', {date: lastChecked|timestamp('short')}) }}
        {% else %}
            {{ 'URLs haven’t been checked yet.'|t('freelink') }}
        {% endif %}
    </p>
{% endblock %}
