{
    "name": "justinholtweb/craft-freelink",
    "version": "6.0.0-beta.1",
    "description": "A powerful, lightweight link field for Craft CMS 6 with hybrid storage, proper element relations, a link index with broken-link checks, and migration from Craft's Link field.",
    "type": "craft-plugin",
    "license": "proprietary",
    "keywords": [
        "craft",
        "craftcms",
        "craft-plugin",
        "link",
        "link field",
        "url",
        "fields"
    ],
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "issues": "https://github.com/justinholtweb/craft-freelink/issues",
        "source": "https://github.com/justinholtweb/craft-freelink",
        "docs": "https://github.com/justinholtweb/craft-freelink/blob/6.0.0/README.md",
        "changelog": "https://raw.githubusercontent.com/justinholtweb/craft-freelink/6.0.0/CHANGELOG.md"
    },
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "craftcms/cms": "^6.0.0-beta.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "JustinHoltWeb\\FreeLink\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustinHoltWeb\\FreeLink\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check-cs": "pint --test",
        "fix-cs": "pint"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "extra": {
        "name": "FreeLink",
        "handle": "freelink",
        "class": "JustinHoltWeb\\FreeLink\\Plugin",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-freelink/blob/6.0.0/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-freelink/6.0.0/CHANGELOG.md"
    }
}
