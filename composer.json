{
    "name": "justinholtweb/craft-freelink",
    "version": "5.0.2",
    "description": "A powerful, lightweight link field for Craft CMS 5 with hybrid storage, proper element relations, and migration paths from popular link plugins.",
    "type": "craft-plugin",
    "license": "proprietary",
    "keywords": [
        "craft",
        "craftcms",
        "craft-plugin",
        "link",
        "link field",
        "url",
        "fields"
    ],
    "support": {
        "email": "justin@justinholt.com",
        "issues": "https://github.com/justinholtweb/craft-freelink/issues",
        "source": "https://github.com/justinholtweb/craft-freelink",
        "docs": "https://github.com/justinholtweb/craft-freelink/blob/main/README.md",
        "changelog": "https://raw.githubusercontent.com/justinholtweb/craft-freelink/main/CHANGELOG.md"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\freelink\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\freelink\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "name": "FreeLink",
        "handle": "freelink",
        "hasCpSettings": false,
        "hasCpSection": false,
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-freelink/main/CHANGELOG.md",
        "class": "justinholtweb\\freelink\\Plugin",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-freelink/blob/main/README.md"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
